공지사항

SELECT NOTICE_NO, NOTICE_TITLE
FROM NOTICE
WHERE STATUS = '게시중'
;

SELECT NOTICE_TITLE, CONTENT, FILES, CREATED_DATE
FROM NOTICE
WHERE STATUS = '게시중' AND NOTICE_NO = 'N000001'
;

주소록
SELECT ORGANIZATION_NO, ORGANIZATION_NAME
FROM ORGANIZATION 
WHERE USER_NO = ''

SELECT GROUPS_NO, GROUPS_NAME
FROM GROUPS
WHERE USER_NO = ''

SELECT U.USER_NO, USER_NAME, PROFILEIMAGE, RANK_NAME, POSITION_NAME, EMAIL
FROM USERS U JOIN TITLE T ON U.USER_NO = T.USER_NO
JOIN RANK R ON R.RANK_NO = T.RANK_NO
JOIN POSITION P ON P.POSITION_NO = T.POSITION_NO

